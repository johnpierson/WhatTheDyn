<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <UseWPF>true</UseWPF>
        <LangVersion>latest</LangVersion>
        <!-- Must match the <Assembly> path in WhatTheDyn.addin and the WhatTheDynamo namespace used by the source. -->
        <AssemblyName>WhatTheDynamo</AssemblyName>
        <PlatformTarget>x64</PlatformTarget>
        <ImplicitUsings>true</ImplicitUsings>
        <!-- Deploy to the local Revit Addins folder for F5 debugging only; Release builds must not touch the machine's Revit install. -->
        <PublishAddinFiles>$(Configuration.StartsWith('Debug'))</PublishAddinFiles>
        <Configurations>Debug R25;Debug R26;Debug R27</Configurations>
        <Configurations>$(Configurations);Release R25;Release R26;Release R27</Configurations>
    </PropertyGroup>

    <!--
        RevitApiVersion is pinned exactly rather than floated as $(RevitVersion).*.
        Floating ranges previously broke the build with no commit to this repo, when a
        newer package stopped supplying a transitive dependency the source relied on.
        Bump these deliberately.
    -->
    <PropertyGroup Condition="$(Configuration.Contains('R25'))">
        <RevitVersion>2025</RevitVersion>
        <RevitApiVersion>2025.4.50</RevitApiVersion>
        <TargetFramework>net8.0-windows</TargetFramework>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R26'))">
        <RevitVersion>2026</RevitVersion>
        <RevitApiVersion>2026.4.10</RevitApiVersion>
        <TargetFramework>net8.0-windows</TargetFramework>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R27'))">
        <RevitVersion>2027</RevitVersion>
        <RevitApiVersion>2027.2.0</RevitApiVersion>
        <TargetFramework>net10.0-windows</TargetFramework>
    </PropertyGroup>

    <PropertyGroup>
        <StartAction>Program</StartAction>
        <StartProgram>C:\Program Files\Autodesk\Revit $(RevitVersion)\Revit.exe</StartProgram>
        <StartArguments>/language ENG</StartArguments>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Nice3point.Revit.Build.Tasks" Version="2.0.2" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" />
        <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="$(RevitApiVersion)" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Resources\Icons\RibbonIcon16.png" />
        <Resource Include="Resources\Icons\RibbonIcon32.png" />
    </ItemGroup>

</Project>